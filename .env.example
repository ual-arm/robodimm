# Robodimm App Mode (production | development)
VITE_APP_MODE=production

# Local PRO backend configuration
VITE_ENABLE_PRO_BACKEND=true
VITE_PRO_BACKEND_URL_PRIMARY=http://127.0.0.1:8001
VITE_PRO_BACKEND_URL_FALLBACK=http://localhost:8001

# Inject the exact Git commit for exported sizing-report provenance.
VITE_ROBODIMM_SOURCE_COMMIT=

# Raw SHA-256 of public/actuators_library.json for release evidence.
VITE_ACTUATOR_CATALOG_SHA256=
